# Copy this file to .env and fill in your values. Never commit .env.
# LEAGUE_ID: from your league URL, e.g. https://fantasy.espn.com/basketball/league?leagueId=123456
LEAGUE_ID=
# Current season = the year the NBA season ENDS (2025-26 season -> 2026)
SEASON=2027
# From your browser cookies on espn.com (DevTools > Application > Cookies > https://fantasy.espn.com)
ESPN_S2=
# Include the curly braces, e.g. {ABCD-1234-...}
SWID=
